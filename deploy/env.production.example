# ===== Portal PQRS — PRODUCCIÓN =====
# Copia a /var/www/html/app-pqrs/.env y completa los valores marcados con <>.
APP_NAME="Portal PQRS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<pqrs.tudominio.com>
APP_TIMEZONE=America/Bogota

# Dominio del panel central. Las empresas quedan en <subdominio>.<este dominio>
CENTRAL_DOMAINS=<pqrs.tudominio.com>

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL — el usuario necesita CREATEDB (una base por empresa)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pqrs
DB_USERNAME=pqrs
DB_PASSWORD=<contraseña-segura>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo (ver docs/correo-microsoft-365.md). Probar: php artisan pqrs:probar-correo tu@correo.com
MAIL_MAILER=microsoft-graph
MAIL_FROM_ADDRESS="<pqrs@tudominio.com>"
MAIL_FROM_NAME="${APP_NAME}"
MICROSOFT_GRAPH_TENANT_ID=<>
MICROSOFT_GRAPH_CLIENT_ID=<>
MICROSOFT_GRAPH_CLIENT_SECRET=<>
PQRS_MAIL_PER_MINUTE=20
PQRS_MAIL_PER_DAY=0

PQRS_CAPTCHA=true
PQRS_CSP=enforce
PQRS_ATTACHMENTS_MAX_KB=5120
PQRS_ATTACHMENTS_MAX_TOTAL_KB=10240

# Si hay Cloudflare / balanceador / proxy delante: sus IP o *. Vacío = directo.
TRUSTED_PROXIES=

PQRS_HELP_DESK_URL=https://tic.itmsas.net

# openssl rand -base64 32   (NO cambiar después: invalida las passkeys)
PASSKEYS_USER_HANDLE_SECRET=<>

VITE_APP_NAME="${APP_NAME}"

# Super administrador que crea el primer despliegue (db:seed)
PQRS_SUPER_ADMIN_EMAIL=<admin@tudominio.com>
PQRS_SUPER_ADMIN_PASSWORD=<contraseña-larga>

APP_NAME="Portal PQRS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

# Dominio(s) del panel central, separados por coma. Las empresas usan <subdominio>.<primer dominio>
CENTRAL_DOMAINS=localhost,127.0.0.1

# Casilla «No soy un robot» del formulario de PQRS (ALTCHA, sin servicios externos)
PQRS_CAPTCHA=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Cada empresa tiene su propia base (tenant_<id>), así que el
# usuario necesita permiso para crear bases de datos (CREATEDB).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pqrs
DB_USERNAME=pqrs
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo que envía los avisos de todas las empresas. Pruébalo con:
#   php artisan pqrs:probar-correo alguien@gmail.com
#
# Microsoft 365 (recomendado): MAIL_MAILER=microsoft-graph, sin contraseña
# del buzón. Ver docs/correo-microsoft-365.md. MAIL_FROM_ADDRESS es el buzón
# que envía (p. ej. pqrs@tuempresa.com).
#
# Por SMTP, MAIL_FROM_ADDRESS debe ser el mismo correo de MAIL_USERNAME:
#   Gmail (con contraseña de aplicación): MAIL_HOST=smtp.gmail.com, MAIL_PORT=587
#   Outlook.com/Hotmail personal: ya no permite enviar con contraseña por SMTP.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=

# Topes del buzón que envía (ver config/pqrs.php). PER_DAY=0 es sin tope;
# con una cuenta gratuita, déjalo por debajo del límite diario del proveedor.
PQRS_MAIL_PER_MINUTE=20
PQRS_MAIL_PER_DAY=0

# Política de seguridad del navegador: enforce (producción), report (solo avisa) u off.
# PQRS_CSP=enforce

# Adjuntos (KB): por archivo y por envío. El servidor debe permitirlo: en php.ini
# upload_max_filesize >= 5M y post_max_size >= 11M; en nginx client_max_body_size 12m.
# Si PHP permite menos, la app usa el límite de PHP.
PQRS_ATTACHMENTS_MAX_KB=5120
PQRS_ATTACHMENTS_MAX_TOTAL_KB=10240

# Detrás de nginx (proxy), un balanceador o Cloudflare: sus IP separadas por coma,
# o * si al servidor solo se llega por el proxy. Vacío = conexión directa.
TRUSTED_PROXIES=

# Mesa de ayuda a la que el módulo «Mesa de ayuda» del panel lleva a administradores y agentes.
PQRS_HELP_DESK_URL=https://tic.itmsas.net

# Llaves de acceso (passkeys) de los super administradores: un valor fijo y secreto
# (p. ej. el resultado de «openssl rand -base64 32»). Si se deja vacío usa APP_KEY,
# y cambiar APP_KEY dejaría inservibles las llaves ya registradas.
PASSKEYS_USER_HANDLE_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Super administrador que crea «php artisan db:seed» (obligatorio en producción)
PQRS_SUPER_ADMIN_EMAIL=admin@pqrs.test
PQRS_SUPER_ADMIN_PASSWORD=
